          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "eventos"
          ]
        }
      }
    },
    {
      "name": "2. Crear evento",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
              "const item = pm.response.json();",
              "pm.test(\"Tiene id\", () => pm.expect(item.id).to.exist);",
              "pm.collectionVariables.set(\"id\", item.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
