# Copia este archivo como .env (nunca subas .env a GitHub)
PORT=30xx
NODE_ENV=xxxxxxxxxx

# PostgreSQL local o con docker compose (mismos datos que docker-compose.yml):
DATABASE_URL="postgresql://(misma):(misma)@localhost:5432/(misma)?schema=public"

# Secreto para firmar los JWT: una frase larga y aleatoria. En Railway va en Variables.
JWT_SECRET="cambia-esta-frase-por-una-larga-y-aleatoria"
JWT_EXPIRES_IN="4h"

# MongoDB (Unidad 2) con docker compose: usuario root del contenedor → authSource=admin
MONGODB_URI="mongodb://espe_user:espe_password@localhost:27017/kromaevents?authSource=admin"

# MongoDB Atlas (alternativa): reemplaza <db_password> (codificada en URL si tiene @ : / ? # %)
# MONGODB_URI="mongodb+srv://<usuario>:<db_password>@cluster0.rpbnucr.mongodb.net/kromaevents?retryWrites=true&w=majority&appName=Cluster0"
