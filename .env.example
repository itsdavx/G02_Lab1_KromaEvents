# Copia este archivo como .env (nunca subas .env a GitHub)
PORT=30xx
NODE_ENV=xxxxxxxxxx

# PostgreSQL local o con docker compose (mismos datos que docker-compose.yml):
DATABASE_URL="postgresql://(misma):(misma)@localhost:5432/(misma)?schema=public"

# Secreto para firmar los JWT: una frase larga y aleatoria. En Railway va en Variables.
JWT_SECRET="cambia-esta-frase-por-una-larga-y-aleatoria"
JWT_EXPIRES_IN="4h"